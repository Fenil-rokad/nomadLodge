<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>New listing</title>
</head>
<body>
    <h1>Add your listing</h1>
    <form action="/listings" method="post">
        <label for="title">Title : </label>
        <input type="text" id="title" name="title" placeholder="Type title here..">

        <label for="description">Description :</label>
        <textarea name="description" id="description" placeholder="Add description..."></textarea>

        <label for="image">Image URL/Link :</label>
        <input type="text" id="image" name="image" placeholder="Type image URL/Link">

        <label for="price">Price :</label>
        <input type="number" id="price" name="price" placeholder="Add amount..">

        <label for="location">Location : </label>
        <input type="text" id="location" name="location" placeholder="Add location">

        <label for="country">Country</label>
        <input type="text" id="country" name="country" placeholder="Add country">

        <button type="submit">Add</button>
    </form>
</body>
</html>