<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= listing.title %></title>
</head>
<body>
    <h1><%= listing.title %></h1>
    <img src="<%= listing.image %>" alt="Loading..">
    <ul>
        <li><p><b>Description</b>: <%= listing.description %></p></li>
        <li><p><b>Price</b>: <%= price %></p></li>
        <li><p><b>Location</b>: <%= listing.location %></p></li>
        <li><p><b>Country</b>: <%= listing.country %></p></li>
    </ul>
    <form action="/listings/<%= listing._id %>/edit" method="get">
        <button type="submit">Edit</button>
    </form>
</body>
</html>