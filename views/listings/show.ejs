<% layout('layouts/boilerplate') %>

    <body>
        <div class="container mb-5 mt-5">
            <div class="row justify-content-center">
                <h1 class="text-center mb-4">
                    <%= listing.title %>
                </h1>

                <div class="card show-card mb-4">

                    <img src="<%= listing.image %>" alt="Loading.." class="card-img-top shadow-lg mb-4">

                    <div class="card-body text-center">

                        <p class="card-text">
                            <%= listing.description %>
                        </p>

                        <p>
                            <b>Price:</b>
                            <%= listing.price.toLocaleString("en-IN", { style: "currency" , currency: "INR" ,
                                maximumFractionDigits: 0, }); %>
                        </p>

                        <p>
                            <b>Location:</b>
                            <%= listing.location %>
                        </p>

                        <p>
                            <b>Country:</b>
                            <%= listing.country %>
                        </p>

                        <div class="d-flex gap-3">
                            <form action="/listings/<%= listing._id %>/edit" method="get" class="flex-fill">
                                <button type="submit" class="btn w-100 ">
                                    Edit
                                </button>
                            </form>

                            <form action="/listings/<%= listing._id %>?_method=DELETE" method="post" class="flex-fill">
                                <button type="submit" class="btn w-100">
                                    Delete
                                </button>
                            </form>
                        </div>
                    </div>
                </div>

                <hr>

                <!-- form for adding reviews -->
                <h2 class="text-center mb-4">
                    Add review
                </h2>
                <div class="col-md-8 col-lg-6 mb-5">
                    <div class="card shadow-lg border-0">
                        <div class="card-body p-4">
                            <form action="/listings/<%= listing._id %>/review" method="post" class="needs-validation"
                                novalidate>
                                <div class="mb-3">
                                    <div class="form-floating">
                                        <textarea class="form-control" placeholder="Leave a review here" id="comment"
                                            style="height: 100px" name="comment" required></textarea>
                                        <label for="comment">Comments</label>
                                        <div class="invalid-feedback">
                                            Please write a review before hitting submit..
                                        </div>
                                    </div>
                                </div>
                                <div class="mb-3">
                                    <label class="form-label" for="rating">Rating</label>
                                    <input type="range" class="form-range" id="rating" min="1" max="5" name="rating">
                                </div>
                                <div class="d-grid">
                                    <button type="submit" class="btn btn-primary">Submit Review</button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
                <hr>
                <h2 class="text-center mb-4 mb-4 mt-3">All Reviews</h2>
                <% for(review of reviews){ %>
                    <p><b>Comment:</b>
                        <%= review.comment %>
                    </p>
                    <p><b>Rating:</b>
                        <%= review.rating %>
                    </p>
                    <small class="text-muted">
                        <%= review.createdAt.toLocaleString("en-IN", { day: "2-digit" , month: "short" , year: "numeric"
                            , hour: "2-digit" , minute: "2-digit" , hour12: true }) %>
                    </small>
                    <% } %>
            </div>
        </div>
    </body>