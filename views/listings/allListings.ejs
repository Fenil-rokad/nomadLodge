<% layout(`layouts/boilerplate`) %>

    <body>
        <form action="/listings/new" method="get">
            <button>New listing</button>
        </form>
        <ul>
            <% for(listing of allListings){ %>
                <li>
                    <a href="/listings/<%= listing._id %>">
                        <%= listing.title %>
                    </a>
                </li>
                <% } %>
        </ul>
    </body>